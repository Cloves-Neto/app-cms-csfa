# ==============================================================================
# CSFA CMS FRONT-END — CONFIGURAÇÕES DE AMBIENTE (app-cms-csfa)
# ==============================================================================

# 🌐 ENDPOINT DA API BACK-END
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# ⏱️ TIMEOUT DE REQUISIÇÃO (Milissegundos)
VITE_API_TIMEOUT=15000

# 🔐 CHAVES DE PERSISTÊNCIA NO LOCALSTORAGE
VITE_TOKEN_STORAGE_KEY=token
VITE_REFRESH_TOKEN_STORAGE_KEY=csfa_refresh_token
